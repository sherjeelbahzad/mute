# Copy to .env.local and fill in.
# Stripe secret key from https://dashboard.stripe.com/apikeys (use the sk_test_ key while developing)
STRIPE_SECRET_KEY=

# Public URL of the site, used for Stripe redirect URLs when the Origin header is missing
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel ID from Events Manager (leave empty to disable tracking)
NEXT_PUBLIC_META_PIXEL_ID=
