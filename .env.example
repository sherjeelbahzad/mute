# Copy to .env.local and fill in.
# Stripe secret key from https://dashboard.stripe.com/apikeys (use the sk_test_ key while developing)
STRIPE_SECRET_KEY=

# Public URL of the site, used for Stripe redirect URLs, share tags, the catalog feed and server events
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Pixel ID from Events Manager (leave empty to disable tracking)
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API: Events Manager > your pixel > Settings > Generate access token.
# With this set, every paid order also sends a server-side Purchase event (deduplicated with the pixel).
META_CAPI_ACCESS_TOKEN=
# Optional: a test event code from Events Manager > Test events, so server events show up there while testing
META_CAPI_TEST_EVENT_CODE=
# Optional: Graph API version for the Conversions API (defaults to v23.0)
META_GRAPH_VERSION=

# Meta domain verification token (Business Settings > Brand Safety > Domains > Meta-tag verification).
# The site emits the meta tag when this is set.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
